{
  "name": "@coreai-ds/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook playground that previews @coreai-ds/react-components against the canonical Fluent UI v9 stories.",
  "scripts": {
    "storybook:prepare": "npm run stories:ensure && npm run stories:generate && npm run docs:templates && npm run docs:skill",
    "dev": "npm run storybook:prepare && storybook dev -p 6006",
    "build": "npm run storybook:prepare && storybook build -o storybook-static",
    "clean": "rimraf --glob storybook-static \"src/stories/templates/*.mdx\" src/stories/docs/AgentSkill.mdx",
    "verify:build": "node scripts/verify-storybook-build.mjs && node --test scripts/fluent-story-version.test.mjs scripts/story-inventory.test.mjs scripts/generate-component-stories.test.mjs scripts/story-source.test.mjs scripts/story-descriptions.test.mjs scripts/guidance-mcp.test.mjs scripts/ingestion-mcp.test.mjs",
    "test:host": "node --test \"host/*.test.mjs\"",
    "type-check": "tsc --noEmit",
    "stories:ensure": "node scripts/setup-fluent-stories.mjs --if-missing",
    "stories:init": "node scripts/setup-fluent-stories.mjs",
    "stories:update": "node scripts/setup-fluent-stories.mjs",
    "stories:inventory": "node scripts/story-inventory.mjs",
    "stories:generate": "node scripts/generate-component-stories.mjs",
    "test:generated": "node --test scripts/generate-component-stories.test.mjs",
    "test:source": "node --test scripts/story-source.test.mjs",
    "stories:verify-source": "node scripts/verify-story-sources.mjs",
    "test:inventory": "node --test scripts/story-inventory.test.mjs",
    "docs:templates": "node scripts/generate-template-docs.mjs",
    "docs:skill": "node scripts/generate-skill-doc.mjs"
  },
  "dependencies": {
    "@coreai-ds/react-components": "*",
    "@ctrl/tinycolor": "^3.6.1",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-components": "^9.74.0",
    "@fluentui/react-drawer": "^9.13.0",
    "@fluentui/react-icons": "^2.0.300",
    "@fluentui/react-motion": "^9.10.0",
    "@fluentui/react-motion-components-preview": "^0.15.5",
    "@fluentui/react-shared-contexts": "^9.26.2",
    "@fluentui/react-theme": "^9.2.1",
    "@fluentui/react-utilities": "^9.26.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/addon-mcp": "10.6.1",
    "@storybook/icons": "^1.3.2",
    "@storybook/mcp": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "react-window": "^1.8.10",
    "storybook": "10.6.2",
    "typescript": "~5.5.4",
    "vite": "^6.3.5"
  }
}
