{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    "paths": {
      "@coreai-ds/react-components": ["../../packages/react-components/src/index.ts"],
      "@coreai-ds/react-headless-components": [
        "../../packages/react-headless-components/src/index.ts"
      ],
      "@coreai-ds/react-components/fonts/*": ["../../packages/react-components/src/fonts/*"]
    }
  },
  // Type-check covers code we own (src/ and .storybook/). The canonical Fluent
  // story sources under ./fluent-stories/ are imported at build time by
  // webpack (via Storybook's stories glob in .storybook/main.ts) but are NOT
  // type-checked here — they're upstream code we don't maintain and they have
  // pre-existing TS errors (missing subpath exports, implicit any, etc.) that
  // would otherwise break our CI.
  "include": ["src/**/*", ".storybook/**/*"],
  "exclude": ["node_modules", "storybook-static"]
}
