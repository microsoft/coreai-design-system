{
  "name": "@coreai-ds/docsite",
  "version": "0.0.0",
  "private": true,
  "description": "CoreAI design system documentation site — a React SPA built on the @coreai-ds/react-components package.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:content": "node scripts/generate-content.mjs",
    "generate:content:refresh": "node scripts/generate-content.mjs --refresh-storybook",
    "dev": "npm run generate:content && vite",
    "build": "npm run generate:content && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "type-check": "npm run generate:content && tsc --noEmit",
    "clean": "rimraf dist content/generated"
  },
  "dependencies": {
    "@coreai-ds/react-components": "*",
    "@fluentui/react-components": "^9.74.0",
    "@fluentui/react-icons": "^2.0.300",
    "@paper-design/shaders": "0.0.81",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "postprocessing": "6.39.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gray-matter": "^4.0.3",
    "rimraf": "^6.0.1",
    "typescript": "~5.5.4",
    "vite": "^6.4.4"
  }
}
