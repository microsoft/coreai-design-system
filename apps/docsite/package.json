{
  "name": "@coreai-ds/docsite",
  "version": "0.1.1",
  "private": true,
  "description": "Static CoreAI documentation with React examples and Markdown references.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:content": "node scripts/GenerateContent.mjs",
    "generate:content:refresh": "node scripts/GenerateContent.mjs --refresh-storybook",
    "dev": "npm run build && npm run preview",
    "build": "npm run sources:ensure && npm --workspace @coreai-ds/react-components run build && node scripts/BuildDocsite.mjs",
    "sources:ensure": "node scripts/sources/SetupFluentStories.mjs --if-missing",
    "sources:update": "node scripts/sources/SetupFluentStories.mjs",
    "catalog:init": "node scripts/InitializeReferenceCatalog.mjs",
    "check:versions": "node scripts/DocumentationVersion.mjs",
    "sync:versions": "node scripts/DocumentationVersion.mjs --sync",
    "version": "npm run sync:versions",
    "verify": "node scripts/VerifyDocsite.mjs",
    "preview": "node scripts/ServeDocsite.mjs",
    "start": "npm run preview",
    "test": "node --test test/*.test.mjs",
    "type-check": "npm run check:versions && npm run generate:content && tsc --noEmit",
    "clean": "rimraf dist .cache/reference-proof content/generated"
  },
  "dependencies": {
    "@coreai-ds/react-components": "*",
    "@ctrl/tinycolor": "^3.6.1",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-components": "^9.74.0",
    "@fluentui/react-icons": "^2.0.300",
    "@fluentui/react-jsx-runtime": "^9.4.6",
    "@fluentui/react-motion-components-preview": "^0.15.5",
    "@fluentui/react-utilities": "^9.26.4",
    "@paper-design/shaders": "0.0.81",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "postprocessing": "6.39.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "react-window": "^1.8.10",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "gray-matter": "^4.0.3",
    "react-docgen-typescript": "^2.4.0",
    "remark-stringify": "^11.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.5.4",
    "vite": "^6.4.6"
  }
}
