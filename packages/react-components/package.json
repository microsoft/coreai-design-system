{
  "name": "@coreai-ds/react-components",
  "version": "0.12.0",
  "description": "CoreAI Design System — a Fluent UI v9 theme and extension for Azure and CoreAI products",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/coreai-design-system.git",
    "directory": "packages/react-components"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/fonts/fonts.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fonts/fonts.css": "./src/fonts/fonts.css"
  },
  "files": [
    "dist",
    "src/fonts/fonts.css",
    "agent",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/generate-illicons.mjs && tsc -p tsconfig.build.json",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "test": "node ../../scripts/generate-illicons.mjs && vitest run",
    "test:component": "node ../../scripts/generate-illicons.mjs && vitest run",
    "test:tree-shaking": "npm run build && node scripts/test-tree-shaking.mjs",
    "test:package": "npm run clean && npm run build && node scripts/verify-package.mjs",
    "test:install-browser": "playwright install chromium",
    "test:watch": "node ../../scripts/generate-illicons.mjs && vitest",
    "type-check": "node ../../scripts/generate-illicons.mjs && tsc --noEmit",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "hast-util-to-jsx-runtime": "^2.3.6",
    "react-dropzone": "^14.4.1",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "@fluentui/react-components": "^9.70.0",
    "@fluentui/react-icons": "^2.0.316",
    "react": ">=16.14.0 <20.0.0",
    "react-dom": ">=16.14.0 <20.0.0"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.7",
    "@fluentui/react-icons": "2.0.339",
    "@types/hast": "^3.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "typescript": "~5.5.4",
    "vite": "^6.4.3",
    "vitest": "4.1.11",
    "vitest-browser-react": "2.2.0"
  }
}
