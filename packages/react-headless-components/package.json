{
  "name": "@coreai-ds/react-headless-components",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental CoreAI components built with Fluent headless behavior and CSS Modules.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm --workspace @coreai-ds/react-components run build && vite build && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@coreai-ds/react-components": "*",
    "@fluentui/react-headless-components-preview": "0.3.2",
    "@fluentui/react-icons": "2.0.343",
    "@fluentui/react-utilities": "9.27.0"
  },
  "peerDependencies": {
    "react": ">=16.14.0 <20.0.0"
  },
  "devDependencies": {
    "@fluentui/react-button": "9.11.1",
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.5.4",
    "vite": "^6.4.3",
    "vitest": "4.1.11",
    "vitest-browser-react": "2.2.0"
  }
}
